{
  "name": "civic-work-desk",
  "version": "0.1.0",
  "private": true,
  "description": "CivicWorkDesk - a local-first, installable PWA for keeping public-sector work records and honour/award archives.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rhymer-Lcy/civic-work-desk.git"
  },
  "homepage": "https://github.com/Rhymer-Lcy/civic-work-desk#readme",
  "bugs": {
    "url": "https://github.com/Rhymer-Lcy/civic-work-desk/issues"
  },
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "css-types": "node scripts/generate-css-module-types.mjs",
    "build": "npm run css-types && npm run typecheck && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium-desktop --project=chromium-mobile",
    "test:a11y": "playwright test --project=a11y",
    "test:e2e:cross": "playwright test --project=firefox-desktop --project=webkit-desktop",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install:cross": "playwright install firefox webkit",
    "scan:static": "node scripts/static-security-scan.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run scan:static && npm run build",
    "review:package": "node scripts/create-review-package.mjs",
    "review:verify": "node scripts/verify-review-package.mjs",
    "screenshots": "playwright test --project=screenshots",
    "lint:uos": "node scripts/uos/lint-shell.mjs",
    "test:uos": "node scripts/uos/run-deployment-tests.mjs",
    "test:uos:archive": "node scripts/uos/archive-tests.mjs",
    "verify:uos": "npm run lint:uos && npm run test:uos && npm run test:uos:archive",
    "test:windows": "node scripts/windows/run-go-tests.mjs",
    "build:windows": "node scripts/windows/build-release.mjs",
    "accept:windows": "node scripts/windows/acceptance-deploy.mjs",
    "accept:windows:browser": "node scripts/windows/acceptance-browser.mjs",
    "verify:windows": "npm run test:windows && npm run audit:copy && npm run build:windows",
    "audit:copy": "node scripts/copy-audit.mjs",
    "scan:release": "node scripts/windows/scan-release-artifact.mjs",
    "accept:windows:ux": "node scripts/windows/acceptance-ux.mjs",
    "assert:release:provenance": "node scripts/windows/assert-release-provenance.mjs",
    "assert:release:identity": "node scripts/windows/assert-release-identity.mjs"
  },
  "dependencies": {
    "date-fns": "4.4.0",
    "dexie": "4.4.6",
    "docx": "9.7.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.1.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
